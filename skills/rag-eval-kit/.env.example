# Local-only settings. ragkit does NOT auto-load this file; see README.md for
# safe PowerShell instructions to import it into the current process.
# Use a separate OpenAI project/key for judging. Never paste the key into chat.
RAGKIT_OPENAI_API_KEY=
# User-selected per-run USD cap. Set a positive value only when authorizing
# paid calls; CLI --budget-usd overrides this value. Zero blocks paid calls.
RAGKIT_BUDGET_USD=0
# The CLI enforces these privacy settings before importing DeepEval.
DEEPEVAL_TELEMETRY_OPT_OUT=1
DEEPEVAL_DISABLE_DOTENV=1
DEEPEVAL_DISABLE_LEGACY_KEYFILE=1
DEEPEVAL_AUTO_TRACE=0
OTEL_SDK_DISABLED=true
